// intelbrew.sh Worker. No account_id and no routes here on purpose: the account
// comes from the Workers Builds Git connection, and the custom domain
// (intelbrew.sh) is added in the dashboard under Settings -> Domains & Routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelbrew-sh",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Only reachable at the custom domain: no *.workers.dev hostname, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these two paths run the script (UA sniffing and the installer
    // proxy); every other path is served straight from ./public.
    "run_worker_first": ["/", "/install.sh"]
  },
  // Workers Logs off (owner's setting): no stored request metadata or client IPs.
  // Upstream failures still go to console.error / wrangler tail.
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
