// intelbrew.sh Worker. No account_id and no routes here on purpose: the account
// comes from the Workers Builds Git connection, and the custom domain
// (intelbrew.sh) is added in the dashboard under Settings -> Domains & Routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelbrew-sh",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Only reachable at the custom domain: no *.workers.dev hostname, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The script runs first for every path ("/" and "/install.sh" for UA
    // sniffing and the installer) except the non-HTML static files listed
    // with "!", which are served straight from ./public with public/_headers.
    // So missing paths (the 404 page) and any other HTML go through the
    // script, which adds "charset=utf-8" to bare text/html.
    // A new non-HTML file in ./public needs a "!" entry here (a test checks).
    "run_worker_first": [
      "/*",
      "!/img/*",
      "!/style.css",
      "!/copy.js",
      "!/favicon.ico",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/robots.txt"
    ]
  },
  // Workers Logs off (owner's setting): no stored request metadata or client IPs.
  // Upstream failures still go to console.error / wrangler tail.
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
